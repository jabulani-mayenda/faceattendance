# Set a strong unique value before first startup.
FACETRACK_ADMIN_PASSWORD=replace-with-a-unique-password-of-12-characters-or-more
# Set COOKIE_SECURE=1 only when deployed behind HTTPS.
COOKIE_SECURE=0
# Generate and keep this secret unchanged after enrolling templates:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACETRACK_BIOMETRIC_KEY=replace-with-a-generated-fernet-key
# Use an IANA timezone name, for example Africa/Blantyre.
FACETRACK_TIMEZONE=Africa/Blantyre
# Initial threshold follows the OpenCV SFace cosine example; tune only after local validation.
FACETRACK_MATCH_THRESHOLD=0.363
# Optional SQLAlchemy URL. Default: sqlite:///./facetrack.db
# DATABASE_URL=sqlite:///./facetrack.db
